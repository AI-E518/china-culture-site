---
import { categoryLabel } from '../i18n';
interface Props {
  post: any;
}
const { post } = Astro.props;
const { data, slug } = post;
const href = `/${data.lang}/posts/${slug}`;
const catLabel = categoryLabel(data.lang, data.category);
---
<article class="card">
  <a class="card-link" href={href}>
    <div
      class="card-cover"
      style={data.cover ? `background-image:url(${data.cover})` : ''}
    >
      {!data.cover && <span class="cover-fallback">{catLabel}</span>}
    </div>
    <div class="card-body">
      <span class="tag">{catLabel}</span>
      <h3>{data.title}</h3>
      <p>{data.summary}</p>
    </div>
  </a>
</article>
