---
// 全站表单提交处理（集中绑定一次，避免重复绑定）。
// 锦囊订阅 / 咨询两类表单统一 POST 到本站 /api/submit（服务端转发 Brevo，前端不含任何第三方密钥）。
// 提交时自动补来源信息：页面路径、文章 slug、页面语种、表单位置，服务端清洗后写入 Brevo 联系人属性。
// 另含锦囊 CTA 曝光埋点（滚入视口打一次点，GET /api/submit?imp=1，返回 204 不落库）。
---
<script>
  if (!(window as any).__clFormsBound) {
    (window as any).__clFormsBound = true;

    const LANGS = ['en', 'zh', 'ja', 'ko'];

    function showStatus(form: HTMLFormElement, msg: string, cls: string) {
      const status = form.querySelector('[data-status]') as HTMLElement | null;
      if (!status) return;
      status.textContent = msg;
      status.hidden = false;
      status.className = 'form-status ' + cls;
    }

    // 组装来源信息。这些值只是「线索」，服务端会重新校验白名单 / 路径格式，不直接信任。
    function buildMeta(form: HTMLFormElement) {
      const path = location.pathname;
      const m = path.match(/^\/([a-z]{2})\/posts\/([^/]+)/);
      const pageLang = (document.documentElement.lang || (m && m[1]) || '').toLowerCase();
      let article = '';
      if (m) {
        try {
          article = decodeURIComponent(m[2]);
        } catch {
          article = m[2];
        }
      }
      return {
        type: form.getAttribute('data-form') === 'consult' ? 'consult' : 'kit',
        src_url: path,
        src_article: article,
        src_lang: LANGS.indexOf(pageLang) >= 0 ? pageLang : '',
        src_slot: form.getAttribute('data-slot') || '',
      };
    }

    async function submitForm(form: HTMLFormElement) {
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value?.trim() || '';
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showStatus(form, form.dataset.err || 'Invalid email', 'error');
        return;
      }

      const data: Record<string, any> = {};
      new FormData(form).forEach((v, k) => {
        if (k in data) {
          data[k] = Array.isArray(data[k]) ? [...data[k], v] : [data[k], v];
        } else {
          data[k] = v;
        }
      });
      Object.assign(data, buildMeta(form));

      // 发信改为同步等待，提交期间禁用按钮防止重复提交
      const btn = form.querySelector('[type="submit"]') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;

      try {
        const res = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.ok) {
          form.reset();
          showStatus(form, form.dataset.ok || 'Thank you!', 'success');
        } else {
          console.warn('[submit] 提交失败：', res.status, json.error);
          showStatus(form, form.dataset.err || 'Something went wrong.', 'error');
        }
      } catch {
        showStatus(form, form.dataset.err || 'Something went wrong.', 'error');
      } finally {
        if (btn) btn.disabled = false;
      }
    }

    document.addEventListener('submit', async (e) => {
      const form = e.target as HTMLFormElement;
      if (!form || !(form instanceof HTMLFormElement)) return;
      const kind = form.getAttribute('data-form');
      if (kind !== 'kit' && kind !== 'consult') return;
      e.preventDefault();
      await submitForm(form);
    });

    // 锦囊 CTA 曝光埋点：滚入视口 50% 即打一次点（GET /api/submit?imp=1）。
    // 返回 204，不落库；转化 = 提交数 / 曝光数，可在 Cloudflare 请求分析里统计。
    function trackKitImpressions() {
      const els = Array.from(document.querySelectorAll('.kit')) as HTMLElement[];
      if (!els.length || !('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            const el = en.target as HTMLElement;
            if (en.isIntersecting && !el.dataset.imp) {
              el.dataset.imp = '1';
              const url = '/api/submit?imp=1';
              if (navigator.sendBeacon) navigator.sendBeacon(url);
              else fetch(url, { method: 'GET', keepalive: true });
              io.unobserve(el);
            }
          });
        },
        { threshold: 0.5 }
      );
      els.forEach((el) => {
        if (!el.dataset.imp) io.observe(el);
      });
    }
    (window as any).__clTrackKit = trackKitImpressions;

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', trackKitImpressions);
    } else {
      trackKitImpressions();
    }
  }
</script>
