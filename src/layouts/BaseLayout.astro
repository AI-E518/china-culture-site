---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormHandler from '../components/FormHandler.astro';
import { SITE } from '../site.config';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogType?: string;
}
const {
  title,
  description = 'Discover authentic Chinese food and intangible cultural heritage.',
  lang = 'en',
  ogType = 'website',
} = Astro.props;

const siteUrl = SITE.url; // 上线时在 src/site.config.ts 改成你的真实域名
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="China Living" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'China Living',
      url: siteUrl,
    })}></script>
  </head>
  <body>
    <Header lang={lang} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <FormHandler />
  </body>
</html>
