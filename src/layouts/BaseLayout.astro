---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormHandler from '../components/FormHandler.astro';
import KitBar from '../components/KitBar.astro';
import { SITE } from '../site.config';
import { LANGS } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogType?: string;
  // 文章页显式传入各语种对应地址（文章 slug 各语种不同，无法靠 URL 前缀推导）；
  // 不传则按当前 URL 前缀自动推导（适用于所有栏目/列表/城市页，四语种路径同构）。
  alternates?: { lang: string; href: string }[];
  // 显式规范链接；不传则按当前 URL 推导。
  canonical?: string;
}
const {
  title,
  description = 'Discover authentic Chinese food and intangible cultural heritage.',
  lang = 'en',
  ogType = 'website',
  alternates,
  canonical,
} = Astro.props;

const siteUrl = SITE.url; // 上线时在 src/site.config.ts 改成你的真实域名
const base = siteUrl.replace(/\/$/, '');

// 计算 hreflang 备选地址：文章页用显式传入，其余页面按 URL 前缀自动推导四语种
let links: { lang: string; href: string }[];
if (alternates && alternates.length) {
  links = alternates;
} else {
  const basePath = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/';
  links = LANGS.map((l) => ({ lang: l, href: `${base}/${l}${basePath}` }));
}
const cano =
  canonical ??
  `${base}/${lang}${(Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '') || '/')}`;
// x-default 指向英文版（默认语种）；若无英文版则取首个可用语种，避免出现孤立页
const xDefault = links.find((l) => l.lang === 'en')?.href ?? links[0]?.href ?? cano;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="China Living" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* 规范链接 + 四语种 hreflang：让 Google 等搜索引擎把各语言版本识别为同一篇内容的不同语言版，
        避免四语种互相抢权重（SEO 国际化标准做法）。x-default 指向默认语种（英文）。 */}
    <link rel="canonical" href={cano} />
    {links.map((l) => <link rel="alternate" hreflang={l.lang} href={l.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'China Living',
      url: siteUrl,
    })}></script>
    {/* Cloudflare Web Analytics：隐私友好、无需 Cookie 同意；token 在 src/site.config.ts 填写后自动启用 */}
    {SITE.analyticsToken && (
      <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${SITE.analyticsToken}"}`}></script>
    )}
  </head>
  <body>
    <KitBar lang={lang} />
    <Header lang={lang} />
    <main class="container">
      <slot />
    </main>
    <Footer lang={lang} />
    <FormHandler />
  </body>
</html>
