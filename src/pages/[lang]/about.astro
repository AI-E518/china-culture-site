---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, t } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const c = t(lang).about;
---
<BaseLayout title={`${c.title} · China Living`} lang={lang}>
  <section class="about">
    <h1>{c.heading}</h1>
    {c.paragraphs.map((p) => <p set:html={p} />)}
    <p class="sign">{c.sign}</p>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 720px;
    margin: 2rem auto 4rem;
    line-height: 1.9;
  }
  .about h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
  }
  .about p {
    margin: 0 0 1.4rem;
    font-size: 1.05rem;
  }
  .about .sign {
    margin-top: 2rem;
    color: #8a8a8a;
  }
</style>
