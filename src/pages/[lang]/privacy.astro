---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LANGS, t } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const c = t(lang).privacy;
---
<BaseLayout title={`${c.title} · China Living`} lang={lang} description={c.heading}>
  <section class="legal">
    <h1>{c.heading}</h1>
    {c.paragraphs.map((p) => <p set:html={p} />)}
  </section>
</BaseLayout>

<style>
  .legal {
    max-width: 720px;
    margin: 2rem auto 4rem;
    line-height: 1.9;
  }
  .legal h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
    color: #d2492a;
  }
  .legal p {
    margin: 0 0 1.4rem;
    font-size: 1.05rem;
  }
</style>
