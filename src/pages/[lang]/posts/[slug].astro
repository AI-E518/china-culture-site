---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// 旅游/实用指南的 FAQ：生成 FAQPage 结构化数据，便于 AI 搜索（GEO）引用
const faqJson =
  data.faq && data.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const faqTitle = t(data.lang).post.faq;

const catLabel =
  data.category === 'heritage'
    ? t(data.lang).post.catHeritage
    : data.category === 'food'
    ? t(data.lang).post.catFood
    : t(data.lang).post.catTravel;
---
<BaseLayout
  title={`${data.title} · China Living`}
  description={data.summary}
  lang={data.lang}
  ogType="article"
>
  <article class="post">
    <a class="back" href={`/${data.lang}/${data.category}`}>← {catLabel}</a>
    <span class="tag">{catLabel}</span>
    <h1>{data.title}</h1>
    <p class="post-meta">
      {data.location ? data.location + ' · ' : ''}{data.pubDate.toISOString().slice(0, 10)}
    </p>
    {data.cover && <img class="post-cover" src={data.cover} alt={data.title} />}
    <div class="prose"><Content /></div>
    {faqJson && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
    )}
    {data.faq && data.faq.length > 0 && (
      <section class="faq">
        <h2>{faqTitle}</h2>
        {data.faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    )}
  </article>
</BaseLayout>
