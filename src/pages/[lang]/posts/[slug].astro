---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n';
import { SITE } from '../../../site.config';
import KitForm from '../../../components/KitForm.astro';

// 同一篇文章的译文靠 slug 末尾的 -{lang} 后缀归组（如 beijing-roast-duck-zh / -en / -ja / -ko）。
// 去掉语言后缀得到 base，所有同 base 的已发布文章互为译文。
export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.draft);
  return posts.map((post) => {
    const base = post.slug.replace(/-(en|ja|ko|zh)$/, '');
    // 收集同一篇在各语种下的已发布译文，生成 hreflang 备选地址
    const group = posts.filter((p) => p.slug.replace(/-(en|ja|ko|zh)$/, '') === base);
    const alternates = group.map((p) => ({
      lang: p.data.lang,
      href: new URL(`/${p.data.lang}/posts/${p.slug}`, SITE.url).href,
    }));
    const canonical = new URL(`/${post.data.lang}/posts/${post.slug}`, SITE.url).href;
    return {
      params: { lang: post.data.lang, slug: post.slug },
      props: { post, alternates, canonical },
    };
  });
}
const { post, alternates, canonical } = Astro.props;
const { Content } = await render(post);
const { data } = post;

// 旅游/实用指南的 FAQ：生成 FAQPage 结构化数据，便于 AI 搜索（GEO）引用
const faqJson =
  data.faq && data.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const faqTitle = t(data.lang).post.faq;

const catLabel =
  data.category === 'heritage'
    ? t(data.lang).post.catHeritage
    : data.category === 'food'
    ? t(data.lang).post.catFood
    : t(data.lang).post.catTravel;
---
<BaseLayout
  title={`${data.title} · China Living`}
  description={data.summary}
  lang={data.lang}
  ogType="article"
  alternates={alternates}
  canonical={canonical}
>
  <article class="post">
    <a class="back" href={`/${data.lang}/${data.category}`}>← {catLabel}</a>
    <span class="tag">{catLabel}</span>
    <h1>{data.title}</h1>
    <p class="post-meta">
      {data.location ? data.location + ' · ' : ''}{data.pubDate.toISOString().slice(0, 10)}
    </p>
    {data.cover && <img class="post-cover" src={data.cover} alt={data.title} />}
    <div class="prose"><Content /></div>
    {/* 文中段卡：默认隐藏，页面加载后由脚本插入正文约 40% 处，成为内联卡片 */}
    <div id="kit-mid" class="kit-mid-slot" hidden>
      <KitForm lang={data.lang} variant="mid" />
    </div>
    {faqJson && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJson)}></script>
    )}
    {data.faq && data.faq.length > 0 && (
      <section class="faq">
        <h2>{faqTitle}</h2>
        {data.faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    )}
    {/* 文末大卡：主转化位（带 id=subscribe，供顶部公告条滚动定位） */}
    <KitForm lang={data.lang} variant="end" />
  </article>
</BaseLayout>

<script is:inline>
  // 将文中段卡插入正文约 40% 处（Astro <Content/> 无法在渲染期切分，故客户端插入）
  (function () {
    function injectMid() {
      var prose = document.querySelector('.prose');
      var slot = document.getElementById('kit-mid');
      if (!prose || !slot || slot.dataset.injected) return;
      var kids = Array.prototype.slice.call(prose.children);
      if (!kids.length) {
        prose.appendChild(slot);
      } else {
        var target = kids[Math.floor(kids.length * 0.4)] || kids[kids.length - 1];
        prose.insertBefore(slot, target);
      }
      slot.hidden = false;
      slot.dataset.injected = '1';
      // 段卡就位后重新登记曝光埋点
      if (window.__clTrackKit) window.__clTrackKit();
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', injectMid);
    } else {
      injectMid();
    }
  })();
</script>
