---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConsultForm from '../../components/ConsultForm.astro';
import { LANGS, t } from '../../i18n';
import { SITE } from '../../site.config';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const c = t(lang).contact;
---
<BaseLayout title={`${c.title} · China Living`} lang={lang} description={c.intro}>
  <section class="contact">
    <h1>{c.heading}</h1>
    <p class="contact-intro">{c.intro}</p>
    <ConsultForm lang={lang} />
    <p class="contact-direct">
      {c.directLabel}<a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 680px;
    margin: 2rem auto 4rem;
  }
  .contact h1 {
    font-size: 2rem;
    margin-bottom: 0.8rem;
    font-weight: 700;
    color: #d2492a;
  }
  .contact-intro {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .contact-direct {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line, #e5ddd3);
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .contact-direct a {
    color: #b5603a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
